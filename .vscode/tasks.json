{
  "version": "2.0.0",
  // Task bodies live in scripts/*.sh (shared with the root workspace tasks and
  // the local deploy MCP in ../steamdeck-dev-mcp/local_mcp/); tasks just export
  // the config-derived env and call them.
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "group": { "kind": "build", "isDefault": true },
      "detail": "pnpm build the frontend into dist/",
      "command": "bash scripts/build-frontend.sh",
      "problemMatcher": []
    },
    {
      "label": "deploy",
      "type": "shell",
      "group": "none",
      "detail": "Stage the exact on-device layout locally, then rsync --delete it to the Deck for a clean, from-scratch copy",
      // sudo rsync on the remote side (plugins/ is root-owned) — needs the
      // passwordless rule from scripts/setup-deck-sudo.sh. See deploy-plugin.sh
      // for the staging/flattening rationale.
      "command": "DECK_HOST='${config:deckuser}@${config:deckip}' DECK_PORT='${config:deckport}' DECK_KEY='${config:deckkey}' DECK_DIR='${config:deckdir}' PLUGIN_NAME='${config:pluginname}' bash scripts/deploy-plugin.sh",
      "problemMatcher": []
    },
    {
      "label": "restartdecky",
      "type": "shell",
      "group": "none",
      "detail": "Restart the plugin_loader service on the Deck",
      "command": "DECK_HOST='${config:deckuser}@${config:deckip}' DECK_PORT='${config:deckport}' DECK_KEY='${config:deckkey}' bash scripts/restart-decky.sh",
      "problemMatcher": []
    },

    // ──────────────── ALL-IN-ONE: build → deploy → restart ───────────────
    {
      "label": "builddeploy",
      "detail": "Build the frontend, deploy to the Deck, and restart Decky",
      "dependsOrder": "sequence",
      "dependsOn": ["build", "deploy", "restartdecky"],
      "group": "none",
      "problemMatcher": []
    },

    // ─────────────────────────── UTILITIES ───────────────────────────
    {
      "label": "taillog",
      "type": "shell",
      "group": "none",
      "detail": "Tail this plugin's backend log on the Deck",
      "command": "ssh -p ${config:deckport} ${config:deckkey} ${config:deckuser}@${config:deckip} 'tail -f \"${config:deckdir}/homebrew/logs/${config:pluginname}\"/*.log'",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "checkconnection",
      "type": "shell",
      "group": "none",
      "detail": "Verify SSH access to the Deck",
      "command": "DECK_HOST='${config:deckuser}@${config:deckip}' DECK_PORT='${config:deckport}' DECK_KEY='${config:deckkey}' DECK_DIR='${config:deckdir}' bash scripts/check-connection.sh",
      "problemMatcher": []
    }
  ]
}
